{
  "name": "bas-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BAS - Living Pixel Art World & Citizen Progression on Solana",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "postinstall": "pnpm build:packages",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:web": "pnpm --filter @bas/web build",
    "build": "pnpm build:packages && pnpm build:web",
    "dev": "pnpm build:packages && pnpm --filter @bas/web dev",
    "dev:packages": "pnpm --filter \"./packages/*\" --parallel dev",
    "lint": "pnpm --filter \"@bas/*\" lint",
    "typecheck": "pnpm build:packages && pnpm --filter \"@bas/*\" typecheck",
    "test": "pnpm --filter \"@bas/*\" test",
    "assets": "node scripts/check-assets.mjs",
    "mainnet:check": "node scripts/check-mainnet.mjs",
    "metadata": "node scripts/gen-metadata.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm lint && pnpm build",
    "program:check": "cargo check --all-targets",
    "program:test": "cargo test --manifest-path programs/district/Cargo.toml",
    "program:build": "cargo build-sbf --manifest-path programs/district/Cargo.toml",
    "program:test-sbf": "cargo test-sbf --manifest-path programs/district/Cargo.toml -- --test-threads=1",
    "market:test": "cargo test --manifest-path programs/market/Cargo.toml",
    "market:test-core": "cargo test --manifest-path programs/market/integration/Cargo.toml",
    "market:build": "cargo build-sbf --manifest-path programs/market/Cargo.toml",
    "market:build-devnet": "cargo build-sbf --manifest-path programs/market/Cargo.toml --features devnet-clock",
    "prize:test": "cargo test --manifest-path programs/prize_vault/Cargo.toml",
    "prize:build": "cargo build-sbf --manifest-path programs/prize_vault/Cargo.toml",
    "prize:build-devnet": "cargo build-sbf --manifest-path programs/prize_vault/Cargo.toml --features devnet-clock",
    "prize:test-sbf-devnet": "BAS_PRIZE=sbf SBF_OUT_DIR=\"$PWD/target/deploy\" cargo test --manifest-path programs/prize_vault/Cargo.toml --features devnet-clock",
    "market:test-sbf": "BAS_MARKET=sbf SBF_OUT_DIR=\"$PWD/target/deploy\" cargo test --manifest-path programs/market/integration/Cargo.toml",
    "market:test-sbf-devnet": "BAS_MARKET=sbf SBF_OUT_DIR=\"$PWD/target/deploy\" cargo test --manifest-path programs/market/integration/Cargo.toml --features devnet-clock",
    "devnet:deploy": "bash scripts/devnet/deploy.sh",
    "devnet:deploy-market": "PROGRAM=market bash scripts/devnet/deploy.sh",
    "devnet:market-setup": "node --env-file-if-exists=.env scripts/devnet/market-setup.mjs",
    "devnet:deploy-prize": "PROGRAM=prize_vault bash scripts/devnet/deploy.sh",
    "devnet:prize": "node --env-file-if-exists=.env scripts/devnet/prize-vault.mjs",
    "devnet:setup": "node --env-file-if-exists=.env scripts/devnet/setup.mjs",
    "devnet:mint-setup": "node --env-file-if-exists=.env scripts/devnet/mint-setup.mjs",
    "devnet:mint-simulate": "node --env-file-if-exists=.env scripts/devnet/mint-simulate.mjs",
    "devnet:send-tokens": "node --env-file-if-exists=.env scripts/devnet/send-tokens.mjs",
    "devnet:citizens": "node --env-file-if-exists=.env scripts/devnet/list-citizens.mjs",
    "devnet:import-key": "node scripts/devnet/import-key.mjs",
    "devnet:transfer": "node --env-file-if-exists=.env scripts/devnet/transfer-asset.mjs",
    "dev:all": "pnpm services:up && pnpm build:packages && concurrently --kill-others --names missions,chat,worker,web --prefix-colors blue,green,yellow,magenta \"pnpm --filter @bas/mission-server start\" \"pnpm --filter @bas/chat-server start\" \"pnpm --filter @bas/worker start\" \"pnpm --filter @bas/web dev\"",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "chat:smoke": "pnpm build:packages && pnpm --filter @bas/chat-server smoke",
    "clean": "pnpm --filter \"@bas/*\" clean && rm -rf apps/web/.next"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
