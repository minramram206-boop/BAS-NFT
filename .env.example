# BAS District — environment template
# Copy to `.env` at the repository root and fill in real values. The devnet scripts,
# the mission server and the web app all read that one file (variables already set in
# the shell win). Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Cluster selection
# ---------------------------------------------------------------------------
# devnet | mainnet-beta. Anything else falls back to devnet.
# Mainnet is never the implicit default.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# The RPC endpoint and every address come from config/<network>.json.

# ---------------------------------------------------------------------------
# Web app data source (apps/web, see docs/ARCHITECTURE.md section 3a)
# ---------------------------------------------------------------------------
# Empty or `mock`: the in-memory mock. `chain`: read the cluster, sign with the
# connected wallet and use the mission server for missions.
NEXT_PUBLIC_BAS_DATA=
# Mission server the web app talks to in chain mode.
NEXT_PUBLIC_MISSION_SERVER_URL=http://localhost:8787
# Optional RPC override for the browser. https only (http only for localhost on
# devnet). Use a hosted RPC: many public endpoints restrict getProgramAccounts.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Mission server (apps/mission-server, see docs/MISSION_SERVER.md)
# ---------------------------------------------------------------------------
# Cluster the server reads and signs for. Same spelling as above.
BAS_NETWORK=devnet
# Key file of the mission authority; must match `missionAuthority` in config/<network>.json.
# `pnpm devnet:setup` writes one to .keys/devnet-mission-authority.json.
MISSION_AUTHORITY_KEYPAIR_FILE=.keys/devnet-mission-authority.json
# At least 64 hex characters (32 bytes); `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
MISSION_TOKEN_SECRET=
# Unix seconds of season day 1. Required.
SEASON_STARTS_AT=
SEASON_ID=1
SEASON_DAYS=28
# Devnet only: seconds in a season day (default 86400). 600 runs a 3-day season in 30 minutes,
# so its prizes can be published and claimed in one sitting (docs/PRIZE_VAULT.md).
SEASON_DAY_SECONDS=
# Where `pnpm devnet:prize finalize` writes the published winners and the server reads them.
PRIZES_DIR=
# Optional JSON object: { "blackoutNight": { "startsAt": 0, "endsAt": 0 } } in unix seconds.
MISSION_EVENTS_FILE=
MISSION_STORE_FILE=./data/missions.json
# Public sale (D-0061). Key file of the Candy Guard `thirdPartySigner`; must match
# `mintSigner` in config/<network>.json. `pnpm devnet:mint-setup` writes one to
# .keys/devnet-mint-signer.json. Leave empty to keep /mint/prepare closed.
MINT_SIGNER_KEYPAIR_FILE=
# Optional unix seconds when the sale opens. Before that /mint/prepare answers mint-not-open.
MINT_OPENS_AT=
PORT=8787
# Comma-separated origins of the web app that may call the server.
ALLOWED_ORIGINS=http://localhost:3000


# ---------------------------------------------------------------------------
# Citizen chat (packages/ai, see docs/AGENTS.md). Off unless CHAT_ENABLED=true.
# The key stays on the server; it never goes to the web app.
# ---------------------------------------------------------------------------
CHAT_ENABLED=false
OPENROUTER_API_KEY=
# Model ids come from here, never from code.
CHAT_MODEL_PRIMARY=
CHAT_MODEL_FALLBACK=
CHAT_MAX_OUTPUT_TOKENS=300
CHAT_REQUEST_TIMEOUT_MS=12000
# Only for models that think before answering (thinking counts against the output tokens, so raise
# CHAT_MAX_OUTPUT_TOKENS too). One of: none, minimal, low, medium, high. Leave empty for other models.
CHAT_REASONING_EFFORT=
# Hard stop for model spend per UTC day.
CHAT_DAILY_BUDGET_USD=
# Used to price a call when the gateway reports no cost.
CHAT_PRICE_INPUT_PER_MILLION_USD=
CHAT_PRICE_OUTPUT_PER_MILLION_USD=
# Sent to OpenRouter as the referer; optional.
CHAT_SITE_URL=
# Chat server (apps/chat-server). Uses MISSION_TOKEN_SECRET and ALLOWED_ORIGINS above.
CHAT_PORT=8788
# Postgres and Redis. Optional on devnet (the chat server then keeps state in memory),
# required on mainnet and for apps/worker. With DATABASE_URL set the mission server also
# keeps the market history in Postgres, so it survives restarts in full.
# With `pnpm services:up` (Docker): postgres://bas:bas@127.0.0.1:5432/bas
DATABASE_URL=
# With `pnpm services:up` (Docker): redis://127.0.0.1:6379
REDIS_URL=
# With REDIS_URL set, the mission server also queues a public-history line for each confirmed mission.
# Web app (apps/web/.env.local): where the chat panel sends messages.
# NEXT_PUBLIC_CHAT_SERVER_URL=http://127.0.0.1:8788
