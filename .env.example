# BAS Pixel District — environment template
# Copy to `.env.local` (web app) or `.env` and fill in real values.
# Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Cluster selection
# ---------------------------------------------------------------------------
# devnet | mainnet-beta. Anything else falls back to devnet.
# Mainnet is never the implicit default.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Optional override of the RPC endpoint from config/<network>.json.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
