{
  "name": "@bas/chain-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed client for the BAS District Solana program",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --experimental-strip-types --conditions=react-server --test --test-reporter=spec \"test/*.test.ts\""
  },
  "dependencies": {
    "@bas/config": "workspace:*"
  },
  "devDependencies": {
    "@bas/content": "workspace:*",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
