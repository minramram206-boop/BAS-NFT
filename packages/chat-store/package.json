{
  "name": "@bas/chat-store",
  "version": "1.0.0",
  "private": true,
  "description": "Postgres and Redis storage for citizen chat (quota, budget, memory, conversations, locks and job queue) and the tables of the market history",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/*.test.ts\""
  },
  "dependencies": {
    "@bas/ai": "workspace:*",
    "bullmq": "6.3.15",
    "ioredis": "5.4.2",
    "pg": "8.13.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "8.11.10",
    "typescript": "^5.7.3"
  }
}
